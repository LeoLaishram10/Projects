   RemoteXY + ESP8266 + TB6612FNG
*/

#define REMOTEXY_MODE__WIFI_POINT

#include <ESP8266WiFi.h>
#include <RemoteXY.h>

// RemoteXY connection settings
#define REMOTEXY_WIFI_SSID "espcar"
#define REMOTEXY_WIFI_PASSWORD "12345678"
#define REMOTEXY_SERVER_PORT 6377

// RemoteXY GUI configuration
#pragma pack(push, 1)
uint8_t const PROGMEM RemoteXY_CONF_PROGMEM[] =
{ 255,2,0,0,0,28,0,19,0,0,0,0,31,2,106,200,200,84,1,1,
  1,0,5,26,83,60,60,36,19,53,53,48,2,26,31 };

struct {
  int8_t joystick_01_x;
  int8_t joystick_01_y;
  uint8_t connect_flag;
} RemoteXY;
#pragma pack(pop)

// ================= TB6612FNG PINS =================
#define STBY D0

// LEFT motors
#define AIN1 D1
#define AIN2 D2
#define PWMA D5

// RIGHT motors
#define BIN1 D3
#define BIN2 D4
#define PWMB D6

// ================= MOTOR FUNCTION =================
void driveMotor(uint8_t in1, uint8_t in2, uint8_t pwm, int speed)
{
  if (speed > 100)  speed = 100;
  if (speed < -100) speed = -100;

  if (speed > 0) {
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
    analogWrite(pwm, speed * 10.23);   // 0–100 → 0–1023
  }
  else if (speed < 0) {
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
    analogWrite(pwm, (-speed) * 10.23);
  }
  else {
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
    analogWrite(pwm, 0);
  }
}

// ================= SETUP =================
void setup()
{
  RemoteXY_Init();

  pinMode(STBY, OUTPUT);
  digitalWrite(STBY, HIGH);

  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(PWMA, OUTPUT);

  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);
  pinMode(PWMB, OUTPUT);
}

// ================= LOOP =================
void loop()
{
  RemoteXY_Handler();   // ✅ CORRECT CALL

  // Differential drive math
  int leftSpeed  = RemoteXY.joystick_01_y + RemoteXY.joystick_01_x;
  int rightSpeed = RemoteXY.joystick_01_y - RemoteXY.joystick_01_x;

  driveMotor(AIN1, AIN2, PWMA, leftSpeed);
  driveMotor(BIN1, BIN2, PWMB, rightSpeed);
}
